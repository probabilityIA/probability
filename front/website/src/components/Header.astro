---
import ExpandedTabs from './ExpandedTabs';

interface Props {
	transparentOnTop?: boolean;
}

const { transparentOnTop = false } = Astro.props;
---

<style>
	.mobile-menu-toggle {
		display: none;
	}

	@media (max-width: 768px) {
		.mobile-menu-toggle {
			display: flex;
		}

		.mobile-menu.hidden {
			display: none;
		}

		.mobile-menu:not(.hidden) {
			display: flex;
		}
	}

	.site-header {
		background-color: #fff;
		border-bottom-color: rgb(229 231 235);
	}

	.site-header.is-transparent-top {
		background-color: transparent;
		border-bottom-color: transparent;
		transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.site-header.is-transparent-top.is-scrolled {
		background-color: #fff;
		border-bottom-color: rgb(229 231 235);
		box-shadow: 0 1px 12px -6px rgba(0, 0, 0, 0.15);
	}

	.header-logo {
		transition: filter 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-logo {
		filter: brightness(0) invert(1);
	}

	.header-register {
		transition: color 0.3s ease, border-color 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-register {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.4);
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-register:hover {
		background-color: rgba(255, 255, 255, 0.1);
	}

	.header-menu-icon {
		transition: color 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-menu-icon {
		color: #fff;
	}

	.site-header.is-transparent-top {
		position: fixed;
		left: 0;
		right: 0;
	}
</style>

<header id="site-header" class={`site-header ${transparentOnTop ? '' : 'sticky'} top-0 z-50 border-b ${transparentOnTop ? 'is-transparent-top' : ''}`}>
	<nav class="mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-4 sm:py-5 flex items-center justify-between h-auto sm:h-20">
		<!-- Logo -->
		<a href="/website/" class="flex items-center gap-3 cursor-pointer group flex-shrink-0">
			<img
				src="https://www.probabilityia.com.co/_next/image?url=%2Flogo2recortado.png&w=1200&q=75"
				alt="probabilityIA logo"
				class="header-logo h-10 sm:h-12 flex-shrink-0 group-hover:scale-110 transition-transform duration-300"
			/>
		</a>

		<!-- Navigation Tabs -->
		<div class="hidden md:flex items-center gap-6 lg:gap-8">
			<ExpandedTabs client:load tabs={[
				{ title: "Producto", iconName: "product", href: "/website/producto" },
				{ title: "Cómo funciona", iconName: "how", href: "/website/como-funciona" },
				{ title: "Precios", iconName: "price", href: "/website/precios" },
				{ title: "Integraciones", iconName: "integration", href: "/website/integraciones" },
				{ title: "Rastreo", iconName: "tracking", href: "/website/rastreo" },
			]} />
		</div>

		<!-- CTA Buttons -->
		<div class="hidden md:flex items-center gap-2 lg:gap-3">
			<a
				href="https://www.probabilityia.com.co/login"
				class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-4 lg:px-5 py-2 rounded-lg font-medium transition-colors text-xs lg:text-sm"
			>
				Inicio de sesión
			</a>
			<a
				href="/website/registrate"
				class="header-register border border-gray-300 text-gray-900 px-4 lg:px-5 py-2 rounded-lg font-medium transition-colors hover:bg-gray-50 text-xs lg:text-sm"
			>
				Registrate
			</a>
		</div>

		<!-- Mobile Menu Button -->
		<button class="header-menu-icon mobile-menu-toggle md:hidden flex items-center gap-2 text-gray-600 hover:text-[#8B5CF6]" id="mobile-menu-btn">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</nav>

	<!-- Mobile Menu -->
	<div class="mobile-menu hidden md:hidden border-t border-gray-200 bg-white" id="mobile-menu">
		<div class="px-4 py-4 space-y-3">
			<a
				href="/website/producto"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Producto
			</a>
			<a
				href="/website/como-funciona"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Cómo funciona
			</a>
			<a
				href="/website/precios"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Precios
			</a>
			<a
				href="/website/integraciones"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Integraciones
			</a>
			<a
				href="/website/rastreo"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Rastreo
			</a>
			<div class="border-t border-gray-200 pt-3 flex flex-col gap-2">
				<a
					href="https://www.probabilityia.com.co/login"
					class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm text-center"
				>
					Inicio de sesión
				</a>
				<a
					href="/website/registrate"
					class="w-full border border-gray-300 text-gray-900 px-4 py-2 rounded-lg font-medium transition-colors hover:bg-gray-50 text-sm text-center"
				>
					Registrate
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	if (mobileMenuBtn && mobileMenu) {
		mobileMenuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});

		const menuLinks = mobileMenu.querySelectorAll('a');
		menuLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.add('hidden');
			});
		});
	}

	const siteHeader = document.getElementById('site-header');
	if (siteHeader) {
		const SCROLL_THRESHOLD = 40;
		const updateHeaderState = () => {
			siteHeader.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
		};
		updateHeaderState();
		window.addEventListener('scroll', updateHeaderState, { passive: true });
	}
</script>
