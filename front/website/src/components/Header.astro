---
interface Props {
	transparentOnTop?: boolean;
}

const { transparentOnTop = false } = Astro.props;
---

<style>
	.mobile-menu-toggle {
		display: none;
	}

	@media (max-width: 768px) {
		.mobile-menu-toggle {
			display: flex;
		}

		.mobile-menu.hidden {
			display: none;
		}

		.mobile-menu:not(.hidden) {
			display: flex;
		}
	}

	.site-header {
		background-color: #fff;
		border-bottom-color: rgb(229 231 235);
	}

	.site-header.is-transparent-top {
		background-color: transparent;
		border-bottom-color: transparent;
		transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.site-header.is-transparent-top.is-scrolled {
		background-color: #fff;
		border-bottom-color: rgb(229 231 235);
		box-shadow: 0 1px 12px -6px rgba(0, 0, 0, 0.15);
	}

.header-logo-text {
		transition: color 0.3s ease;
		color: #111827;
		font-family: 'Poppins', sans-serif;
		font-weight: 500;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-logo-text {
		color: #e5e7eb;
	}

	.header-register {
		transition: color 0.3s ease, border-color 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-register {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.4);
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-register:hover {
		background-color: rgba(255, 255, 255, 0.1);
	}

	.header-nav-link {
		transition: color 0.3s ease, border-color 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-nav-link {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.4);
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-nav-link:hover {
		border-color: #fff;
		color: #fff;
	}

	.header-menu-icon {
		transition: color 0.3s ease;
	}

	.site-header.is-transparent-top:not(.is-scrolled) .header-menu-icon {
		color: #fff;
	}

	.site-header.is-transparent-top {
		position: fixed;
		left: 0;
		right: 0;
	}
</style>

<header id="site-header" class={`site-header ${transparentOnTop ? '' : 'sticky'} top-0 z-50 border-b ${transparentOnTop ? 'is-transparent-top' : ''}`}>
	<nav class="mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-4 sm:py-5 flex items-center justify-between h-auto sm:h-20">
		<!-- Logo -->
		<a href="/website/" class="flex items-center gap-2 cursor-pointer group flex-shrink-0">
			<div class="flex items-center gap-2 group-hover:scale-110 transition-transform duration-300">
				<img
					src="https://probability-media-assets.s3.us-east-1.amazonaws.com/public/brand/logo-mark-badge.svg"
					alt="ProbabilityIA"
					class="h-9 sm:h-10 w-9 sm:w-10 flex-shrink-0"
				/>
				<span class="header-logo-text text-lg sm:text-xl">ProbabilityIA</span>
			</div>
		</a>

		<!-- CTA Buttons -->
		<div class="hidden md:flex items-center gap-2 lg:gap-3 ml-auto">
			<a
				href="/website/rastreo"
				class="header-nav-link flex items-center gap-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg px-4 py-2 hover:text-[#8B5CF6] hover:border-[#8B5CF6] transition-colors"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
				</svg>
				Rastreo
			</a>
			<a
				href="https://www.probabilityia.com.co/login"
				class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-4 lg:px-5 py-2 rounded-lg font-medium transition-colors text-xs lg:text-sm"
			>
				Inicio de sesión
			</a>
			<a
				href="/website/registrate"
				class="header-register border border-gray-300 text-gray-900 px-4 lg:px-5 py-2 rounded-lg font-medium transition-colors hover:bg-gray-50 text-xs lg:text-sm"
			>
				Registrate
			</a>
		</div>

		<!-- Mobile Menu Button -->
		<button class="header-menu-icon mobile-menu-toggle md:hidden flex items-center gap-2 text-gray-600 hover:text-[#8B5CF6]" id="mobile-menu-btn">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</nav>

	<!-- Mobile Menu -->
	<div class="mobile-menu hidden md:hidden border-t border-gray-200 bg-white" id="mobile-menu">
		<div class="px-4 py-4 space-y-3">
			<a
				href="/website/rastreo"
				class="block text-gray-600 hover:text-[#8B5CF6] transition-colors text-base font-medium py-2"
			>
				Rastreo
			</a>
			<div class="border-t border-gray-200 pt-3 flex flex-col gap-2">
				<a
					href="https://www.probabilityia.com.co/login"
					class="w-full bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm text-center"
				>
					Inicio de sesión
				</a>
				<a
					href="/website/registrate"
					class="w-full border border-gray-300 text-gray-900 px-4 py-2 rounded-lg font-medium transition-colors hover:bg-gray-50 text-sm text-center"
				>
					Registrate
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	if (mobileMenuBtn && mobileMenu) {
		mobileMenuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});

		const menuLinks = mobileMenu.querySelectorAll('a');
		menuLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.add('hidden');
			});
		});
	}

	const siteHeader = document.getElementById('site-header');
	if (siteHeader) {
		const SCROLL_THRESHOLD = 40;
		const updateHeaderState = () => {
			siteHeader.classList.toggle('is-scrolled', window.scrollY > SCROLL_THRESHOLD);
		};
		updateHeaderState();
		window.addEventListener('scroll', updateHeaderState, { passive: true });
	}
</script>
