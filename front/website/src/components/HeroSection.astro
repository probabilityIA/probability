---
---

<section class="relative w-full min-h-[85vh] lg:min-h-[620px] overflow-hidden bg-[#FBFAFE] py-16 sm:py-20 md:py-24 flex items-center">
  <style>
    @keyframes pulseDot {
      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.45;
        transform: scale(0.82);
      }
    }

    @keyframes glowBreath {
      0%,
      100% {
        opacity: 0.45;
      }
      50% {
        opacity: 0.85;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
      }
    }

    .hero-grid {
      background-image: radial-gradient(rgba(139, 92, 246, 0.12) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 40%, transparent 100%);
    }

    .glow-blob-purple {
      animation: glowBreath 6s ease-in-out infinite;
    }

    .glow-blob-violet {
      animation: glowBreath 7s ease-in-out infinite 1s;
    }

    .pulse-dot {
      animation: pulseDot 2s ease-in-out infinite;
    }

    .gradient-text {
      background: linear-gradient(115deg, #a855f7, #7c3aed);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  </style>

  <script define:vars={{ dummy: true }}>
    (function () {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      const duration = 1300;
      const startTime = performance.now();
      const els = document.querySelectorAll('[data-count]');

      const frame = (now) => {
        const elapsed = now - startTime;
        const progress = Math.min(1, elapsed / duration);
        const easeOut = 1 - Math.pow(1 - progress, 3);

        els.forEach((el) => {
          const target = parseFloat(el.getAttribute('data-count'));
          el.textContent = Math.round(target * easeOut);
        });

        if (progress < 1) {
          requestAnimationFrame(frame);
        }
      };

      els.forEach((el) => {
        el.textContent = '0';
      });
      requestAnimationFrame(frame);
    })();
  </script>

  <div class="hero-grid absolute inset-0 z-0"></div>

  <div
    class="glow-blob-purple absolute -top-[120px] -right-[80px] w-[560px] h-[560px] rounded-full bg-gradient-to-br from-purple-400/25 to-transparent blur-[60px] -z-10"
  ></div>
  <div
    class="glow-blob-violet absolute -bottom-[160px] -left-[100px] w-[480px] h-[480px] rounded-full bg-gradient-to-br from-purple-300/20 to-transparent blur-[60px] -z-10"
  ></div>

  <div class="relative z-10 w-full px-4 sm:px-6 lg:px-12">
    <div class="max-w-[720px] mx-auto text-center">
      <div
        class="inline-flex items-center gap-2 bg-white border border-[#E7E2F5] rounded-full px-3 sm:px-4 py-2 mb-6 sm:mb-8 shadow-[0_8px_24px_-12px_rgba(124,58,237,0.4)]"
      >
        <span class="pulse-dot w-2 h-2 rounded-full bg-[#8B5CF6] shadow-[0_0_8px_#8B5CF6]"></span>
        <span class="text-[12.5px] font-bold tracking-[0.06em] text-[#5B5470] uppercase">
          Potenciado por IA
        </span>
      </div>

      <h1
        class="font-space-grotesk font-bold text-4xl sm:text-5xl md:text-6xl lg:text-[58px] leading-[1.05] -tracking-[0.02em] text-[#181225] mb-5 sm:mb-6 text-balance"
      >
        Predice y elimina
        <span class="gradient-text">devoluciones</span>
        antes de que sucedan
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl text-[#5B5470] leading-[1.55] mb-8 sm:mb-[34px] max-w-[560px] mx-auto"
      >
        Probability IA analiza cada pedido en tiempo real para anticipar el
        riesgo de devolución y optimizar tus envíos. Menos pérdidas, más
        margen.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-[14px] mb-10 sm:mb-[46px] justify-center">
        <a
          href="https://meet.brevo.com/probability-ia/reunion-de-30-minutos"
          class="inline-flex items-center justify-center px-6 sm:px-[26px] py-3 sm:py-[15px] font-bold text-sm sm:text-[15.5px] text-white rounded-[13px] bg-gradient-to-r from-[#8B5CF6] to-[#7C3AED] shadow-[0_16px_34px_-12px_rgba(124,58,237,0.7)] hover:shadow-[0_20px_40px_-8px_rgba(124,58,237,0.8)] hover:-translate-y-0.5 transition-all"
        >
          Solicitar demo gratis
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center px-6 sm:px-[26px] py-3 sm:py-[15px] font-bold text-sm sm:text-[15.5px] text-[#3A2E5C] rounded-[13px] bg-white border border-[#E2DCF1] hover:border-[#8B5CF6] hover:text-[#7C3AED] transition-all"
        >
          Contáctanos
        </a>
      </div>

      <div class="flex gap-[30px] sm:gap-[46px] items-end flex-wrap justify-center">
        <div>
          <div class="font-space-grotesk font-bold text-[30px] leading-[1] text-emerald-600">
            ↓<span data-count="28">28</span>%
          </div>
          <div class="text-[13px] text-[#6B6480] mt-1">menos devoluciones</div>
        </div>
        <div class="w-px h-[38px] bg-[#E4DFF0]"></div>
        <div>
          <div class="font-space-grotesk font-bold text-[30px] leading-[1] text-[#181225]">
            <span data-count="93">93</span>%
          </div>
          <div class="text-[13px] text-[#6B6480] mt-1">precisión del modelo</div>
        </div>
        <div class="w-px h-[38px] bg-[#E4DFF0]"></div>
        <div>
          <div class="font-space-grotesk font-bold text-[30px] leading-[1] text-[#181225]">
            1.2M
          </div>
          <div class="text-[13px] text-[#6B6480] mt-1">pedidos/mes</div>
        </div>
      </div>
    </div>
  </div>
</section>
