---
const channels = [
  {
    name: 'Shopify',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/shopify-logo.svg',
  },
  {
    name: 'WooCommerce',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/1765745053_woocomerce.webp',
  },
  {
    name: 'Mercado Libre',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/mercadolibre-icon.svg',
  },
  {
    name: 'Jumpseller',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/jumpseller-icon.png',
  },
  {
    name: 'Tiendanube',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/tiendanube-icon.png',
  },
];

const radius = 38;
const radialChannels = channels.map((c, i) => {
  const angleDeg = -90 + i * (360 / channels.length);
  const angleRad = (angleDeg * Math.PI) / 180;
  return {
    ...c,
    x: 50 + radius * Math.cos(angleRad),
    y: 50 + radius * Math.sin(angleRad),
  };
});

const billers = [
  {
    name: 'Siigo',
    src: 'https://probability-media-assets.s3.us-east-1.amazonaws.com/integration-types/1771738597_siigo.png',
  },
  {
    name: 'Softpymes',
    src: 'https://soporte.softpymes.com.co/hubfs/SPT1%20(1).png',
  },
];

const notifCards = [
  {
    title: 'Reglas por canal y evento',
    description: 'Defines qué evento dispara cada notificación (guía generada, pedido enviado, entregado) por cada canal de venta, sin tocar código.',
  },
  {
    title: 'Campañas por WhatsApp',
    description: 'Crea plantillas de marketing aprobadas por Meta y lánzalas a tu base de clientes directamente desde Probability.',
  },
  {
    title: 'Conversaciones centralizadas',
    description: 'Ves el historial completo de cada chat de WhatsApp con tus clientes, en un solo panel, sin cambiar de aplicación.',
  },
];

const slides = [
  { id: 'channels', tag: 'Canales de venta' },
  { id: 'invoicing', tag: 'Facturación automática' },
  { id: 'notif-1', tag: 'Notificaciones' },
];
---

<section id="feature-carousel-section" class="feature-carousel-section relative w-full overflow-x-clip bg-[#FAF9FD] py-8 sm:py-10 md:py-12">
  <style>
    .feature-carousel-section.is-paused * {
      animation-play-state: paused !important;
    }

    .feature-slide-inner {
      min-height: 470px;
    }

    @media (min-width: 1024px) {
      .feature-slide-inner {
        min-height: 420px;
      }
    }

    .feature-track {
      transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .feature-arrow {
      transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .feature-arrow:hover {
      background: #7C3AED;
      color: #fff;
      transform: translateY(-1px);
    }

    @keyframes invoiceFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .invoicing-mock {
      animation: invoiceFloat 6s ease-in-out infinite;
    }

    .biller-tile,
    .channel-tile {
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .biller-tile:hover,
    .channel-tile:hover {
      transform: translateY(-3px);
      border-color: rgba(196, 181, 253, 0.6);
      box-shadow: 0 14px 26px -14px rgba(196, 181, 253, 0.5);
    }

    @keyframes channelFlow {
      to {
        stroke-dashoffset: -200;
      }
    }

    @keyframes channelFlowReverse {
      to {
        stroke-dashoffset: 200;
      }
    }

    @keyframes channelGlowPulse {
      0%,
      100% {
        opacity: 0.55;
      }
      50% {
        opacity: 1;
      }
    }

    .channel-line {
      fill: none;
      stroke: #a855f7;
      stroke-width: 0.5;
      stroke-linecap: round;
      stroke-dasharray: 1.6 3.2;
      filter: drop-shadow(0 0 2.5px rgba(168, 85, 247, 0.85));
      animation: channelFlow 12s linear infinite, channelGlowPulse 2.4s ease-in-out infinite;
    }

    .channel-line-reverse {
      animation: channelFlowReverse 12s linear infinite, channelGlowPulse 2.4s ease-in-out infinite;
    }

    .metrics-bg {
      filter: blur(1.5px);
      z-index: 0;
    }

    .metrics-figure {
      position: absolute;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      color: #8B5CF6;
      opacity: 0.16;
      white-space: nowrap;
      transform: translate(-50%, -50%);
    }

    .metrics-trend {
      opacity: 0.14;
    }

    .notif-emoji {
      position: absolute;
      opacity: 0.14;
      filter: grayscale(1);
      line-height: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .feature-carousel-section * {
        animation: none !important;
      }
    }
  </style>

  <div class="relative z-10 w-full max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-12">
    <div class="text-center max-w-[680px] mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-2 bg-[#F6F3FD] border border-[#E7E2F5] rounded-full px-3 sm:px-4 py-2 mb-5">
        <span class="w-2 h-2 rounded-full bg-[#8B5CF6]"></span>
        <span id="feature-carousel-tag" class="text-[12.5px] font-bold tracking-[0.06em] text-[#5B5470] uppercase">
          {slides[0].tag}
        </span>
      </div>
    </div>
  </div>

  <div class="relative z-10 w-full">
      <div class="feature-carousel-viewport overflow-hidden">
        <div class="feature-track flex w-full">

          <div class="feature-slide w-full shrink-0" data-tag={slides[0].tag}>
