---
import '../styles/quiz-shared.css';
---

<div id="diagnostic-quiz"></div>

<script>
  import { API_BASE_URL } from '../config/api';

  const SURVEY_SLUG = 'escanea-tu-logistica';

  class DiagnosticQuizEcommerce {
    constructor() {
      this.state = {
        screen: 'intro',
        currentQ: 0,
        answers: [null, null, null, null, null, null],
        lead: { name: '', email: '', phone: '' },
        result: null,
      };

      this.questions = [
        {
          text: '¿Cuántas órdenes envías al mes?',
          hint: 'Incluye todos tus canales de venta',
          options: [
            'Menos de 50 órdenes',
            'Entre 50 y 200 órdenes',
            'Entre 200 y 500 órdenes',
            'Más de 500 órdenes',
          ],
        },
        {
          text: '¿Cuál es tu modelo de pago principal?',
          hint: 'El que representa más del 50% de tus ventas',
          options: [
            'Contra entrega',
            'Mixto (anticipado y contra entrega)',
            'Anticipado (pago online)',
          ],
        },
        {
          text: '¿En cuántos canales de venta estás activo?',
          hint: 'Instagram, TikTok Shop, Mercado Libre, tienda propia, WhatsApp…',
          options: [
            '1 canal',
            '2 a 3 canales',
            '4 o más canales',
          ],
        },
        {
          text: '¿Cuál es tu ticket promedio por pedido?',
          hint: 'Valor del pedido antes de sumar el flete',
          options: [
            'Menos de $50.000 COP',
            '$50.000 – $150.000 COP',
            '$150.000 – $400.000 COP',
            'Más de $400.000 COP',
          ],
        },
        {
          text: '¿Tus clientes reciben actualizaciones automáticas del estado de su pedido?',
          hint: 'Sin que tú lo hagas manualmente — WhatsApp, email o SMS',
          options: [
            'No, no tengo notificaciones activas',
            'A veces, de forma manual o parcial',
            'Sí, de forma automática',
          ],
        },
        {
          text: '¿Cómo registras y haces seguimiento a tus pedidos?',
          hint: 'Desde que el cliente compra hasta que se entrega',
          options: [
            'Papel, WhatsApp o de memoria',
            'Hojas de cálculo (Excel / Sheets)',
            'Plataforma o sistema (OMS / ERP)',
          ],
        },
      ];

      this.maxScore = this.questions.reduce((sum, q) => sum + (q.options.length - 1), 0);

      this.renderAll();
    }

    renderAll() {
      const root = document.getElementById('diagnostic-quiz');
      if (!root) return;
      root.innerHTML = this.getHTML();
      this.attachListeners();
    }

    getHTML() {
      if (this.state.screen === 'intro') return this.renderIntro();
      if (this.state.screen === 'quiz') return this.renderQuiz();
      if (this.state.screen === 'leadform') return this.renderLeadForm();
      if (this.state.screen === 'results') return this.renderResults();
    }

    renderIntro() {
      return `
        <div class="dq-wrapper">
          <div class="dq-container">
            <div class="dq-intro">
              <div class="dq-badge">
                <span class="dq-badge-dot"></span>
                Diagnóstico de operación e-commerce
              </div>
              <h1 class="dq-title">
                Escanea tu <span class="dq-title-gradient">Operación</span>
              </h1>
              <p class="dq-subtitle">
                Responde 6 preguntas y descubre qué tan eficiente es tu operación. Identifica cuellos de botella, tiempo perdido y dinero que puedes recuperar.
              </p>
              <button class="dq-btn-start">Empezar diagnóstico →</button>
              <div class="dq-time">6 preguntas · menos de 2 minutos</div>
            </div>
          </div>
        </div>
      `;
    }

    renderQuiz() {
      const q = this.questions[this.state.currentQ];
      const answered = this.state.answers[this.state.currentQ] != null;
      const pct = ((this.state.currentQ + 1) / this.questions.length) * 100;

      const optionsHTML = q.options
        .map(
          (opt, i) => `
        <div class="dq-option ${this.state.answers[this.state.currentQ] === i ? 'selected' : ''}" data-option="${i}">
          <div class="dq-radio">
            <div class="dq-radio-inner"></div>
          </div>
          <span class="dq-option-label">${opt}</span>
        </div>
      `
        )
        .join('');

      return `
        <div class="dq-wrapper">
          <div class="dq-container">
            <div class="dq-quiz">
              <div class="dq-progress-top">
                <span class="dq-progress-label">Pregunta ${this.state.currentQ + 1} de ${this.questions.length}</span>
                <span class="dq-progress-pct">${Math.round(pct)}%</span>
              </div>
              <div class="dq-progress-track">
                <div class="dq-progress-fill" style="width: ${pct}%"></div>
              </div>

              <div class="dq-card">
                <div class="dq-question-header">
                  <div class="dq-question-num">${this.state.currentQ + 1}</div>
                  <h2 class="dq-question-text">${q.text}</h2>
                </div>
                <div class="dq-options">
                  ${optionsHTML}
                </div>
              </div>

              <div class="dq-buttons">
                <button class="dq-btn-back">
                  ${this.state.currentQ === 0 ? '← Inicio' : '← Atrás'}
                </button>
                <button class="dq-btn-next" ${!answered ? 'disabled' : ''}>
                  ${this.state.currentQ === this.questions.length - 1 ? 'Ver resultados →' : 'Siguiente →'}
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    renderLeadForm() {
      const { name, email, phone } = this.state.lead;
      const canSubmit = name.trim() && email.trim() && phone.trim();

      return `
        <div class="dq-wrapper">
          <div class="dq-container">
            <div class="dq-quiz">
              <div class="dq-card">
                <div class="dq-question-header">
                  <h2 class="dq-question-text">Ya casi. ¿A dónde te enviamos tu resultado?</h2>
                </div>
                <div class="dq-field">
                  <label class="dq-field-label">Nombre completo</label>
                  <input class="dq-input" type="text" data-lead-field="name" value="${name}" placeholder="Tu nombre" />
                </div>
                <div class="dq-field">
                  <label class="dq-field-label">Correo</label>
                  <input class="dq-input" type="email" data-lead-field="email" value="${email}" placeholder="tucorreo@empresa.com" />
                </div>
                <div class="dq-field">
                  <label class="dq-field-label">WhatsApp</label>
                  <input class="dq-input" type="tel" data-lead-field="phone" value="${phone}" placeholder="+57 300 000 0000" />
                </div>
              </div>

              <div class="dq-buttons">
                <button class="dq-btn-back">← Atrás</button>
                <button class="dq-btn-next" ${!canSubmit ? 'disabled' : ''}>Ver mi resultado →</button>
              </div>
              <p class="dq-field-note">Te enviamos tu resultado por WhatsApp y correo. Nuestro equipo puede ayudarte a mejorarlo.</p>
            </div>
          </div>
        </div>
      `;
    }

    submitLead() {
      const { name, email, phone } = this.state.lead;
      fetch(`${API_BASE_URL}/public/marketing-leads`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          phone,
          survey_slug: SURVEY_SLUG,
          score_total: this.state.result.total,
          score_max: this.state.result.max,
          level: this.state.result.level,
          answers: this.state.result.answersDetail,
          recommendations: this.state.result.recommendations,
        }),
      }).catch(() => {
        // silencioso: no bloqueamos el resultado si falla el envio del lead
      });
    }

    computeResult() {
      const scores = this.state.answers.map(a => a ?? 0);
      const total = scores.reduce((a, b) => a + b, 0);
      const max = this.maxScore;

      let level, heroClass, desc, emoji;
      if (total <= max * 0.35) {
        level = 'Básica';
        emoji = '🔴';
        heroClass = 'basic';
        desc = 'Tu operación depende de procesos manuales y de un modelo de pago de alta fricción. Hay una oportunidad grande de recuperar tiempo y margen.';
      } else if (total <= max * 0.7) {
        level = 'Intermedia';
        emoji = '🟡';
        heroClass = 'intermediate';
        desc = 'Tienes una base funcional, pero algunos procesos te están costando tiempo y dinero. Optimizarlos te permitirá escalar sin fricciones.';
      } else {
        level = 'Avanzada';
        emoji = '🟢';
        heroClass = 'advanced';
        desc = 'Tu operación está bien optimizada en volumen, canales y trazabilidad. Ahora el foco es afinar detalles y escalar apoyándote en datos.';
      }

      const answersDetail = this.questions.map((q, i) => ({
        question: q.text,
        answer: q.options[this.state.answers[i] ?? 0],
      }));

      const recommendations = this.buildRecs(scores).map(r => ({ title: r.title, desc: r.desc, type: r.type }));

      return { scores, total, max, level, heroClass, desc, emoji, answersDetail, recommendations };
    }

    buildRecs(a) {
      const recDefs = [
        { title: 'Prepárate para escalar sin caos', desc: 'A partir de 200+ órdenes al mes, los procesos manuales empiezan a colapsar. Centraliza tus pedidos en una sola plataforma antes de que el volumen te desborde.', tags: ['Volumen', 'Escalabilidad'] },
        { title: 'Concilia tus pagos contra entrega sin dolores de cabeza', desc: 'El contra entrega es el modelo con más fricción operativa: recaudo, cartera y conciliación manual. Automatiza el cruce entre lo cobrado por la transportadora y lo que realmente te pagan.', tags: ['Contra entrega', 'Conciliación'] },
        { title: 'Centraliza tus pedidos de todos los canales', desc: 'Vender en varias plataformas sin un solo lugar donde ver todas tus órdenes genera errores y sobreventas. Unifica tu tienda, marketplaces y WhatsApp en un solo tablero.', tags: ['Multicanal', 'Órdenes'] },
        { title: 'Optimiza el flete frente a tu ticket promedio', desc: 'Si el costo de envío se come una parte grande de tu ticket promedio, cada guía generada sin comparar tarifas es margen perdido. Cotiza automáticamente entre transportadoras antes de generar la guía.', tags: ['Flete', 'Margen'] },
        { title: 'Activa notificaciones automáticas de pedido', desc: 'Sin actualizaciones automáticas, tu equipo pierde horas respondiendo "¿dónde está mi pedido?". Notifica a tus clientes por WhatsApp o email en cada cambio de estado, sin que nadie tenga que hacerlo a mano.', tags: ['Notificaciones', 'Experiencia'] },
        { title: 'Excel tiene un techo — ya lo estás alcanzando', desc: 'Por encima de 200 órdenes al mes, las hojas de cálculo generan errores, duplicados y demoras. Migrar a una plataforma de pedidos te da trazabilidad en tiempo real sin esfuerzo extra.', tags: ['Sistema', 'Trazabilidad'] },
      ];

      const maxPerQuestion = this.questions.map(q => q.options.length - 1);

      let recs = [];
      a.forEach((v, i) => {
        const max = maxPerQuestion[i];
        if (v <= Math.floor(max / 2)) {
          recs.push({
            ...recDefs[i],
            type: v === 0 ? 'risk' : 'warning',
          });
        }
      });

      recs.sort((x, y) => (x.type === 'risk' ? 0 : 1) - (y.type === 'risk' ? 0 : 1));

      if (recs.length === 0) {
        recs.push({
          title: 'Tu operación ya está optimizada',
          desc: 'Tienes una base sólida en volumen, canales, pagos y trazabilidad. El siguiente paso es automatizar lo que aún haces a mano para escalar sin aumentar el equipo.',
          tags: ['Optimización', 'Escalabilidad'],
          type: 'success',
        });
      }

      return recs;
    }

    renderResults() {
      const { total, max, level, heroClass, desc, emoji } = this.state.result;

      const remaining = max - total;
      const hoursPerMonth = Math.round(remaining * 6);
      const returnRateLow = Math.round(4 + remaining * 0.6);
      const returnRateHigh = returnRateLow + 7;
      const monthlySavings = Math.round((remaining * 70000) / 1000) * 1000;

      const metricsHTML = `
        <div class="dq-metric">
          <div class="dq-metric-value">${hoursPerMonth}h</div>
          <div class="dq-metric-label">Horas al mes en gestión manual estimadas</div>
        </div>
        <div class="dq-metric">
          <div class="dq-metric-value">${returnRateLow} – ${returnRateHigh}%</div>
          <div class="dq-metric-label">Tasa de devolución estimada según tu modelo de pago</div>
        </div>
        <div class="dq-metric">
          <div class="dq-metric-value dq-metric-price"><span class="dq-peso-sign">$</span>${monthlySavings.toLocaleString('es-CO')}</div>
          <div class="dq-metric-label">Ahorro mensual potencial optimizando tu operación</div>
        </div>
      `;

      const recs = this.buildRecs(this.state.result.scores);
      const recsHTML = recs
        .map((r) => {
          let tagsHtml = r.tags
            .map((tag) => `<span class="dq-tag ${r.type}">${tag}</span>`)
            .join('');
          return `
            <div class="dq-rec">
              <div class="dq-rec-content">
                <div class="dq-rec-title"><span class="dq-checkmark">✓</span> ${r.title}</div>
                <div class="dq-rec-desc">${r.desc}</div>
                <div class="dq-tags">${tagsHtml}</div>
              </div>
            </div>
          `;
        })
        .join('');

      return `
        <div class="dq-wrapper">
          <div class="dq-container">
            <div class="dq-results">
              <div class="dq-hero ${heroClass}">
                <div class="dq-hero-label">${emoji} Nivel de eficiencia operativa</div>
                <div class="dq-hero-title">${level}</div>
                <div class="dq-hero-score">${total} / ${max} puntos</div>
                <p class="dq-hero-desc">${desc}</p>
              </div>

              <div class="dq-metrics">
                ${metricsHTML}
              </div>
              <div class="dq-metrics-note">Estimaciones orientativas calculadas a partir de tus respuestas.</div>

              <h3 class="dq-recs-title">Recomendaciones para tu operación</h3>
              <div class="dq-recs">
                ${recsHTML}
              </div>

              <div class="dq-footer">
                <button class="dq-btn-restart">↺ Repetir diagnóstico</button>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    attachListeners() {
      const startBtn = document.querySelector('.dq-btn-start');
      if (startBtn) {
        startBtn.addEventListener('click', () => {
          this.state.screen = 'quiz';
          this.state.currentQ = 0;
          this.renderAll();
        });
      }

      const options = document.querySelectorAll('[data-option]');
      options.forEach(opt => {
        opt.addEventListener('click', () => {
          const idx = parseInt(opt.getAttribute('data-option'));
          this.state.answers[this.state.currentQ] = idx;
          this.renderAll();
        });
      });

      const nextBtn = document.querySelector('.dq-btn-next');
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (this.state.screen === 'leadform') {
            this.submitLead();
            this.state.screen = 'results';
            this.renderAll();
            return;
          }
          if (this.state.currentQ < this.questions.length - 1) {
            this.state.currentQ++;
          } else {
            this.state.result = this.computeResult();
            this.state.screen = 'leadform';
          }
          this.renderAll();
        });
      }

      const leadFields = document.querySelectorAll('[data-lead-field]');
      leadFields.forEach(field => {
        field.addEventListener('input', () => {
          this.state.lead[field.getAttribute('data-lead-field')] = field.value;
          const submitBtn = document.querySelector('.dq-btn-next');
          if (submitBtn) {
            const { name, email, phone } = this.state.lead;
            submitBtn.disabled = !(name.trim() && email.trim() && phone.trim());
          }
        });
      });

      const backBtn = document.querySelector('.dq-btn-back');
      if (backBtn) {
        backBtn.addEventListener('click', () => {
          if (this.state.screen === 'leadform') {
            this.state.screen = 'quiz';
          } else if (this.state.currentQ === 0) {
            this.state.screen = 'intro';
          } else {
            this.state.currentQ--;
          }
          this.renderAll();
        });
      }

      const restartBtn = document.querySelector('.dq-btn-restart');
      if (restartBtn) {
        restartBtn.addEventListener('click', () => {
          this.state.screen = 'intro';
          this.state.currentQ = 0;
          this.state.answers = [null, null, null, null, null, null];
          this.state.lead = { name: '', email: '', phone: '' };
          this.state.result = null;
          this.renderAll();
        });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new DiagnosticQuizEcommerce();
    });
  } else {
    new DiagnosticQuizEcommerce();
  }
</script>
